msgid "No pending code. Request a new one."
msgstr "Aucun code en attente. Demandez-en un nouveau."

#: services/otp.py:37
msgid "Code has expired. Request a new one."
msgstr "Le code a expiré. Demandez-en un nouveau."

#: services/otp.py:39

msgid "Only staff can list users."
msgstr "Seule l'équipe peut lister les utilisateurs."

#: services/users.py:104
msgid "Only staff can view a user."
msgstr "Seule l'équipe peut consulter un utilisateur."

#: services/users.py:120
msgid "Only staff can ban a user."
msgstr "Seule l'équipe peut suspendre un utilisateur."

#: services/users.py:146
msgid "Only staff can unban a user."
msgstr "Seule l'équipe peut lever la suspension d'un utilisateur."

#: templates/templated_email/account_banned.email:2
#, python-format
msgid "Your %(app_name)s account has been banned"
msgstr "Votre compte %(app_name)s a été suspendu"

#: templates/templated_email/account_banned.email:3
#, python-format
msgid ""
"Your %(app_name)s account has been banned. Reason: %(reason)s.\n"
"\n"
"You can no longer sign in or use the service. If you believe this is a "
"mistake, contact support."
msgstr "Votre compte %(app_name)s a été suspendu. Motif : %(reason)s.\n\nVous ne pouvez plus vous connecter ni utiliser le service. Si vous pensez qu'il s'agit d'une erreur, contactez le support."

#: templates/templated_email/account_banned.email:6
#, python-format
msgid ""
"Your %(app_name)s account has been banned. Reason: <strong>%(reason)s</"
"strong>."
msgstr "Votre compte %(app_name)s a été suspendu. Motif : <strong>%(reason)s</strong>."

#: templates/templated_email/account_banned.email:7
msgid ""
"You can no longer sign in or use the service. If you believe this is a "
"mistake, contact support."
msgstr "Vous ne pouvez plus vous connecter ni utiliser le service. Si vous pensez qu'il s'agit d'une erreur, contactez le support."

#: templates/templated_email/otp.email:2
#, python-format
msgid "Your %(app_name)s verification code"
msgstr "Votre code de vérification %(app_name)s"

#: templates/templated_email/otp.email:3
#, python-format
msgid ""
"Your %(app_name)s verification code is %(code)s. It expires in 10 minutes."
msgstr "Votre code de vérification %(app_name)s est %(code)s. Il expire dans 10 minutes."

#: templates/templated_email/otp.email:4
#, python-format
msgid ""
"Your %(app_name)s verification code is <strong>%(code)s</strong>. It expires "
"in 10 minutes."
msgstr "Votre code de vérification %(app_name)s est <strong>%(code)s</strong>. Il expire dans 10 minutes."

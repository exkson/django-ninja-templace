msgstr "Indique si cet utilisateur doit être considéré comme actif. Activé après une vérification OTP réussie."

#: models/user.py:117
msgid "banned at"
msgstr "suspendu le"

#: models/user.py:121
msgid ""
"Set by staff when the account is banned; cleared on unban. A banned "
"account's token is rejected at authentication time."
msgstr "Renseigné par l'équipe lors de la suspension du compte ; effacé à la levée. Le jeton d'un compte suspendu est refusé à l'authentification."

#: models/user.py:126
msgid "ban reason"
msgstr "motif de suspension"

#: models/user.py:129
msgid "Staff-supplied reason recorded when the account is banned."
msgstr "Motif fourni par l'équipe lors de la suspension du compte."


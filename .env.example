# Required
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars

# Runtime
DEBUG=true
APP_NAME=My App
# ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# FRONTEND_URL=https://app.example.com

# Database (sqlite by default)
# DATABASE_BACKEND=postgres
# DATABASE_NAME=app
# DATABASE_USER=app
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# Tokens
# ACCESS_TOKEN_DURATION_MINUTES=15
# REFRESH_TOKEN_DURATION_DAYS=7

# Email (console backend is handy in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@example.com

# Integrations
# WHATSAPP_BACKEND=core.services.whatsapp.ConsoleWhatsAppClient
# GEO_IP_PROVIDER_URL=https://ipapi.co/{ip}/country/
# DEFAULT_COUNTRY=

# i18n
# LANGUAGE_CODE=en-us
# TIME_ZONE=UTC

# Container
# SUPERUSER_EMAIL=
# SUPERUSER_PASSWORD=
# GUNICORN_WORKERS=2
